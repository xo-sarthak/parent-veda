<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ParentVeda is a LIGHT-ONLY app (MaterialApp uses themeMode:
         ThemeMode.light), so the night-mode variants must NOT be dark.

         These used to be `Theme.Black.NoTitleBar` with windowBackground =
         ?android:colorBackground, which resolves to BLACK under night mode.
         On a phone with system dark mode ON that made the Android window
         behind Flutter solid black, so anything that let the window show
         through - app launch/resume, activity resize, and hybrid composition
         while a platform view (LiveKit/WebRTC, video_player) is alive -
         appeared as a BLACK SCREEN over an otherwise light app.

         Kept as an explicit light override (rather than deleting the folder)
         so it stays obvious that night mode is deliberately light here. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/pv_window_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
