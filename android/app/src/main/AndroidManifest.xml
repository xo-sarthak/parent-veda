<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Watch video player streams over the network (video_player / ExoPlayer).
         Debug builds inject this automatically; declared here so release does too. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice journaling: capture the mother's spoken note. Also used by the
         LiveKit video call (mic). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Live video consults/classes (LiveKit / WebRTC): camera + audio routing. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Saving a Memory card to the gallery on Android 9 and below (gal). API 29+
         uses scoped storage and needs no permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Customizable reminders (flutter_local_notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Exact-time reminders (Android 12+). USE_EXACT_ALARM auto-grants for
         testing now; before a Play Store launch, drop USE_EXACT_ALARM and rely
         on SCHEDULE_EXACT_ALARM + the runtime request (Play flags USE_EXACT). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <application
        android:label="parentveda"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- REFERRAL DEEP LINKS. Opens parentveda.in/invite/<CODE> straight
                 in the app when it is installed.

                 autoVerify="true" makes this an Android App Link rather than a
                 plain deep link: Android checks
                 https://parentveda.in/.well-known/assetlinks.json for this
                 app's signing fingerprint and, if it matches, opens the app with
                 NO disambiguation dialog. Without that file served, the link
                 falls back to a chooser - which still works, just less cleanly.

                 This covers the INSTALLED case only. Carrying a referral through
                 an app-store install is deferred deep linking, which Firebase
                 Dynamic Links used to provide free and no longer does (shut down
                 25 Aug 2025). That case is handled honestly by asking for the
                 code - see enter_code_sheet.dart. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="parentveda.in"
                      android:pathPrefix="/invite" />
                <!-- CARE PARTNER referrals: a doctor's QR, poster or
                     prescription link. Same verified domain, deliberately a
                     DIFFERENT path from /invite so a partner referral can
                     never be resolved as a parent invite (that would credit a
                     mother instead of the doctor, silently). -->
                <data android:scheme="https"
                      android:host="parentveda.in"
                      android:pathPrefix="/care" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Fall back to the Skia renderer instead of Impeller (Vulkan). On some
             Android devices/drivers (seen on Galaxy S21 FE, Android 16) Impeller
             paints modal bottom sheets & dialogs as a solid BLACK overlay while
             the real content sits underneath. Skia renders them correctly.
             Revisit once Impeller stabilises on these devices. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- DELIVERS a scheduled reminder when its alarm fires. Required by
             flutter_local_notifications: the plugin's own manifest declares
             permissions ONLY, no receivers, so the app must declare these or
             AlarmManager broadcasts into a class Android has never heard of and
             drops it silently. Symptom when missing: zonedSchedule() reports
             success, the notification never arrives, and no error surfaces
             anywhere - while show() keeps working, because the immediate path
             never touches this receiver. Do not remove. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Reschedule reminders after a reboot (flutter_local_notifications). -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility for the speech recognizer. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
