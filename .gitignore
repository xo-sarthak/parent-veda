# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.iml
.idea/
.vscode/

# Generated narration.
#
# build/audio holds ~136 MB of mp3 for the Hindi corpus plus a segment cache.
# It is DERIVED - tool/generate_audio.py rebuilds it from the content and the
# manifest, and the segment cache means a rebuild is mostly free. Committing it
# would put a binary blob in every clone and every diff, for files that are
# meant to live on R2 and be fetched once by the app.
#
# What IS committed is the recipe: the generator, the corpus rules, and the
# manifest that maps content key -> file + content hash.
build/audio/

# Android
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
*.jks
*.keystore

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/ephemeral/
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/

# Credentials - never, under any circumstance.
#
# The Google Cloud org policy blocks service-account key creation, which is why
# this project authenticates with Application Default Credentials instead. ADC
# stores its token outside the repo entirely, so there is nothing here to leak.
# These patterns exist so that a future key, added in a hurry, still cannot be
# committed by accident.
*-key.json
*service-account*.json
*credentials*.json
.env
.env.*

# Supabase local scratch
supabase/.temp/

# Translation worklists - derived, and regenerable in one command.
#
# tool/extract_home_hinglish.py rebuilds the h_batch*.tsv worklists from the
# JSON itself, and the *.done.tsv translations have already been applied INTO
# that JSON, which is the artifact that matters. Keeping 7 MB of intermediate
# TSV would double the repo to preserve a scaffold. The house rules the
# translators worked from are NOT derived and are committed.
tool/hindi/h_batch*.tsv
tool/hindi/d_batch*.tsv
tool/hindi/d_all.tsv
tool/hindi/e_owed*.tsv

# Agent scratch. Subagents were told to use a private subdirectory to stop
# them overwriting each other's temp files, and a relative path put it in the
# REPO rather than the session temp dir. Ignored so it cannot be committed by
# accident; the work itself always lands in lib/ or tool/hindi/.
scratchpad/

# Python bytecode from the tool/ scripts
__pycache__/
*.pyc

# `flutter run` output, redirected to a file. 4.5 MB of it, regenerated on
# every run, and it buries real changes in `git status`.
flutter_run*.log
flutter_*.log

# Generated by the Flutter tool on every build. The file says so itself:
# "This is a generated file; do not edit or check into version control."
.flutter-plugins
.flutter-plugins-dependencies

# Generated narration - 66 MB of MP3, and DERIVED rather than authored.
#
# Everything that produces these files is committed and pinned: the text in
# lib/data/weekContent.json, the voice (hi-IN-Chirp3-HD-Callirrhoe), the rate
# and gap settings in tool/generate_audio.py, and a per-passage content hash in
# the manifest. Regenerating the whole library is 114,384 characters - about a
# tenth of the monthly free tier - so losing it costs one command, not data.
#
# Committing it would triple the repo permanently (git cannot drop a blob
# without rewriting history) to protect something that is not at risk. R2 is
# where these are meant to live; this staging directory is local testing.
#
# THE MANIFEST IS COMMITTED on purpose - it is small, it is what
# test/narration_keys_test.dart checks app keys against, and NarrationService
# degrades correctly without the audio: a missing file is caught and falls
# through to the device voice.
#
# ⚠️ If a HUMAN voice artist ever records the flagship passages, those files are
# SOURCE, not derived - no script reproduces a person's voice - and they must
# not be covered by this rule. Decide where they are archived BEFORE paying for
# the session.
assets/narration/hi/*.mp3
assets/narration/hi/*.wav
!assets/narration/hi/.gitkeep

# TTS voice-tuning clips. Scratch from choosing the narration voice
# (hi-IN-Chirp3-HD-Callirrhoe) and the sentence gaps - a decision already made
# and recorded in tool/generate_audio.py. Regenerable from the same script.
voice_samples/

# OS noise
.DS_Store
Thumbs.db
